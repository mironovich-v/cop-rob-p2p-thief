# ---------------------------------------------------------------------------
# vm__fabi — Cop-Thief P2P — environment placeholders.
# Copy to `.env` and fill locally. NEVER commit `.env` or any real secret.
# ---------------------------------------------------------------------------

# Anthropic API key — ONLY needed for the optional trash-talk provider
# `claude_api`. The game MOVE is always pure Python; the default `template`
# provider needs no key. Leave empty unless you opt into cloud banter.
ANTHROPIC_API_KEY=

# Gmail API (send-only) for the result-report email.
# OAuth is configured out-of-band; point these at local, git-ignored files.
# Recipient is fixed by the assignment: rmisegal+uoh26finalgame@gmail.com
GMAIL_CREDENTIALS_PATH=./secrets/credentials.json
GMAIL_TOKEN_PATH=./secrets/token.json

# Public tunnel (Stage 5, cross-implementation play). Provider chosen at
# deploy time; the token stays local. Uncomment the one you use.
# CLOUDFLARE_TUNNEL_TOKEN=
# NGROK_AUTHTOKEN=
